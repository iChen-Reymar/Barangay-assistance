{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    },
    "api/ml-runtime.py": {
      "maxDuration": 60,
      "includeFiles": "ml-service/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/_ml-runtime/(.*)",
      "destination": "/api/ml-runtime"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
